{
  "name": "crypto-dashboard-assets",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss --config tailwind.config.cjs --input static/css/tailwind.input.css --output static/css/tailwind.css --minify",
    "build:assets": "node scripts/build-static-assets.mjs",
    "build": "npm run build:css && npm run build:assets"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "apexcharts": "3.54.1",
    "esbuild": "0.28.2",
    "lucide": "1.63.0",
    "tailwindcss": "3.4.17"
  }
}
